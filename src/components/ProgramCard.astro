---
/**
 * Ficha de un programa (acordeón) — DESIGN.md §6 (Programas y horarios) y
 * §7 (ProgramCard, KeyValueList). docs/content.md §4.
 */
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import type { Program } from '../data/programs';
import { plans } from '../data/plans';

interface Props {
  program: Program;
}
const { program } = Astro.props;

const planNames = program.plans
  .map((id) => plans.find((p) => p.id === id)?.name)
  .filter(Boolean)
  .join(' · ');

const STACK_THRESHOLD = 24;
function rowClass(value: string, extra = ''): string {
  const cls = ['kv-row', extra];
  if (value.length > STACK_THRESHOLD) cls.push('kv-row--stack');
  return cls.filter(Boolean).join(' ');
}
---

<article id={program.id} class="program-card">
  <button
    type="button"
    class="program-card__toggle"
    aria-expanded="false"
    aria-controls={`${program.id}-body`}
  >
    <span class="program-card__name">
      <h3>{program.name}</h3>
      <span class="text-small">{program.summary}</span>
    </span>
    <span class="program-card__chevron" aria-hidden="true">
      <Icon name="chevron" />
    </span>
  </button>

  <div id={`${program.id}-body`} class="program-card__body" hidden>
    <p class="program-card__desc">{program.description}</p>

    <dl class="kv">
      {
        program.schedule.map((s) => (
          <div class={rowClass(`${s.start}–${s.end}`, 'kv-row--time')}>
            <dt>{s.day}</dt>
            <dd>
              {s.start}–{s.end}
            </dd>
          </div>
        ))
      }
      <div class={rowClass(program.instructorName)}>
        <dt>{program.instructorLabel}</dt>
        <dd>{program.instructorName}</dd>
      </div>
      <div class={rowClass(program.duration)}>
        <dt>Duración</dt>
        <dd>{program.duration}</dd>
      </div>
      <div class={rowClass(planNames)}>
        <dt>Planes</dt>
        <dd>{planNames}</dd>
      </div>
    </dl>

    {program.note && <p class="note">{program.note}</p>}

    <WhatsAppButton
      message={program.waMessage}
      cta={program.waCta}
      label="Consultar por WhatsApp"
      ariaLabel={`Consultar por ${program.name}`}
      block
      class="program-card__cta"
    />
  </div>
</article>

<style>
  .program-card {
    background: #fff;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-line);
    margin-bottom: var(--space-2);
    overflow: hidden;
  }
  .program-card:has(.program-card__toggle[aria-expanded='true']) {
    box-shadow: inset 0 0 0 2px var(--color-navy);
  }

  .program-card__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
  }
  .program-card__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .program-card__name .text-small {
    color: var(--color-slate);
  }
  .program-card__chevron {
    flex: none;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-mist);
    color: var(--color-navy);
    transition: transform 0.2s var(--ease);
  }
  .program-card__toggle[aria-expanded='true'] .program-card__chevron {
    transform: rotate(180deg);
  }

  .program-card__body {
    padding: 0 var(--space-4) var(--space-4);
    border-left: 4px solid var(--color-cyan);
    margin-left: var(--space-4);
  }
  .program-card__desc {
    margin: 0 0 var(--space-2);
    color: var(--color-slate);
    font-size: 15px;
  }

  .kv {
    margin: 0;
  }
  .kv-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 10px 0;
    border-top: 1px solid var(--color-line);
    font-size: 15px;
  }
  .kv-row dt {
    color: var(--color-slate);
    flex: none;
  }
  .kv-row dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
  }
  .kv-row--time dd {
    font: 600 var(--fs-time) / 1.3 var(--font-body);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .kv-row--stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .kv-row--stack dd {
    text-align: left;
  }

  .program-card :global(.note) {
    margin-top: var(--space-3);
  }
  .program-card__cta {
    margin-top: var(--space-4);
  }

  /**
   * ≥1024px: vista maestro–detalle (DESIGN.md §6 — "5/12 lista + 7/12 ficha").
   * `.program-card` se "desenvuelve" con display:contents para que su
   * encabezado y su cuerpo pasen a ser hijos directos del grid de dos
   * columnas definido en ProgramsSection.astro. El encabezado (columna 1)
   * y el cuerpo (columna 2) recuperan por separado el aspecto de tarjeta
   * que antes daba el contenedor único.
   */
  @media (min-width: 1024px) {
    .program-card {
      display: contents;
      margin-bottom: 0;
    }
    .program-card__toggle {
      grid-column: 1;
      background: #fff;
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 1px var(--color-line);
      margin-bottom: var(--space-2);
    }
    .program-card__toggle[aria-expanded='true'] {
      box-shadow: inset 0 0 0 2px var(--color-navy);
    }
    .program-card__body {
      grid-column: 2;
      margin-left: 0;
      border-left: 4px solid var(--color-cyan);
      background: #fff;
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 1px var(--color-line);
      padding: var(--space-4) var(--space-5) var(--space-5);
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
    }
  }
</style>
