---
/**
 * Layout base — head, skip-link, Header, slot, Footer, botón flotante.
 * SEO y JSON-LD: docs/content.md §12. Analítica: docs/sitemap.md §4.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site, seo, analytics } from '../data/site';

const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(seo.ogImage, site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: site.fullName,
  url: site.url,
  telephone: site.phoneE164,
  sameAs: [site.instagramUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/logo/icono-light.svg" />
    <link rel="apple-touch-icon" href="/logo/icono-light.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={analytics.umamiWebsiteId}
      data-domains={analytics.umamiDomains}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
